# Independent HF fixtures are external and never silently generated by this test.
set(GLM53_LANE_B_FIXTURE_DIR "$ENV{GLM53_LANE_B_FIXTURE_DIR}" CACHE PATH
  "Directory containing pinned HF GLM-5.3 Lane B NPZ fixtures")
find_package(Python3 COMPONENTS Interpreter QUIET)
if (Python3_Interpreter_FOUND)
  set(GLM53_LANE_B_MODEL_DIR "${PROJECT_SOURCE_DIR}/src/models/glm53_flash")
  add_library(glm53_flash_lane_b_fixture_bridge SHARED
    ${CMAKE_CURRENT_LIST_DIR}/lane_b_bridge.cpp
    ${GLM53_LANE_B_MODEL_DIR}/reference_mla.cpp
    ${GLM53_LANE_B_MODEL_DIR}/reference_moe.cpp)
  target_include_directories(glm53_flash_lane_b_fixture_bridge PRIVATE ${PROJECT_SOURCE_DIR})
  target_compile_features(glm53_flash_lane_b_fixture_bridge PRIVATE cxx_std_20)
  target_compile_options(glm53_flash_lane_b_fixture_bridge PRIVATE -O2)
  add_dependencies(glm53_flash_tests glm53_flash_lane_b_fixture_bridge)
  add_test(NAME glm53_flash.lane_b_reference
    COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/lane_b_fixture_test.py
      "${GLM53_LANE_B_FIXTURE_DIR}"
      --library $<TARGET_FILE:glm53_flash_lane_b_fixture_bridge>)
  set_tests_properties(glm53_flash.lane_b_reference PROPERTIES
    LABELS "glm53_flash;cpu;external-fixture"
    SKIP_RETURN_CODE 77)
endif()

if (ENGINE_ENABLE_HIP)
  add_glm53_flash_test(lane_b_dense gufo_glm53_flash "hip;gpu;gfx1151")
  add_glm53_flash_test(lane_b_iq gufo_glm53_flash "hip;gpu;gfx1151")
  add_glm53_flash_test(lane_b_ffn gufo_glm53_flash_reference "hip;gpu;gfx1151")
  add_glm53_flash_test(lane_b_executor gufo_glm53_flash_reference "hip;gpu;gfx1151")
  target_compile_definitions(glm53_flash_lane_b_executor_test PRIVATE
    GLM53_E2E_FIXTURE="${GLM53_E2E_FIXTURE}")
endif()

if (ENGINE_ENABLE_HIP)
  # Few-token routed expert matvec (kernels/expert_vec.hpp) vs the host build
  # of its block math and an FP64 dequantization oracle.
  add_glm53_flash_test(expert_vec gufo_glm53_flash "hip;gpu;gfx1151")
  set_tests_properties(glm53_flash.expert_vec PROPERTIES SKIP_RETURN_CODE 77)
endif()
